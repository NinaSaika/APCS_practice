#include <bits/stdc++.h>
using namespace std;

//排序數字且出現越多次越往前，若出現次數一樣則小的在前


int  cnt[25];//開25的陣列當計數（題目只要求到20就是了）

bool cmp(int a, int b)//在主程式前先訂規則
{
    if (cnt[a] == cnt[b])
    {
        return a < b;
    }
    else
    {
        return cnt[a] > cnt[b];
    }
    
}




int main() 
{

int n;    
vector<int> o;

cin >> n;//輸入數字長度

for (int i=0; i < n; i++)
    {
    int temp;
    cin>> temp;//依序讀取
    o.push_back(temp);
    cnt[temp]++;
    }


sort(o.begin(), o.end(), cmp);//用 sort 排序、傳入 cmp

for (int i = 0; i < n; i++)
{
    cout << o[i] << " ";//依序印出
}
return 0;
}
