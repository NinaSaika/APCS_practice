#include <bits/stdc++.h>
using namespace std;

//如果存在兩個不同的披薩，滿足價格總和等於X，請輸出兩個索引（1-based index），確保第一個索引小於第二個索引，並以空格分隔。

int main() 
{
int n;
cin >> n;//輸入披薩數量
int p[n + 1];//反正就是開比 n 大的（開出p[0], p[1], p[2], p[3], p[4], p[5]......）

for (int i = 1 ; i <= n; i++) 
{
  cin >> p[i];//輸入披薩價格 i
}


int X;
cin >> X;//輸入派對預算 X

for (int i = 1; i < n; i++) //固定第一個數，依序檢查
{
  for (int j = i + 1; j <= n; j++) //檢查第二個數
  {
    if (p[i] + p[j] == X) //檢查第三個數
    {
      cout << i << " " << j << "\n";//若有找到，輸出兩數
      return 0;//跳出迴圈，結束程式
    }
  }
}
    cout << -1 << "\n";//（找一圈都沒找到的話）輸出-1

    return 0;
}
